{
  "name": "Daniella Sommers Counselling Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Counselling site preview",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8080 --directory demo > /tmp/daniella-preview.log 2>&1 &"
}
